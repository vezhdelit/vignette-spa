# Where the vignette.id API lives (the Express API mounted at /api).
# Leave unset in dev to use the Vite proxy (/api -> VITE_PROXY_TARGET,
# default https://vignette.id) and avoid CORS entirely.
#VITE_VIGNETTE_API_BASE=http://localhost:3000/api

# Dev-proxy target when VITE_VIGNETTE_API_BASE is unset:
#VITE_PROXY_TARGET=http://localhost:3000

# Public client identity (REQUIRED). Create it in the admin dashboard
# (Auth Clients -> New, type "public") and paste the generated id:
VITE_VIGNETTE_CLIENT_ID=vgc_...

# Apple/Google sign-in (POST /public/auth/{apple,google}/verify). Optional and
# independent — the matching button only renders when its client id is set.
# The auth client's apple_audiences/google_audiences must contain these values
# server-side (dashboard PATCH /dashboard/auth-clients/:id).
#
# Google: an OAuth "Web application" client id with this app's origin under
# "Authorized JavaScript origins":
#VITE_VIGNETTE_GOOGLE_CLIENT_ID=
# Apple: a Services ID configured for Sign in with Apple; the redirect URI
# must exactly match a registered Return URL (defaults to <origin>/account):
#VITE_VIGNETTE_APPLE_CLIENT_ID=
#VITE_VIGNETTE_APPLE_REDIRECT_URI=
