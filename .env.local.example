# Where the vignette.id API lives (the Express API mounted at /api).
# Leave unset in dev to use the Vite proxy (/api -> VITE_PROXY_TARGET,
# default https://vignette.id) and avoid CORS entirely.
#VITE_VIGNETTE_API_BASE=http://localhost:3000/api

# Dev-proxy target when VITE_VIGNETTE_API_BASE is unset:
#VITE_PROXY_TARGET=http://localhost:3000

# Public client identity (REQUIRED). Create it in the admin dashboard
# (Auth Clients -> New, type "public") and paste the generated id:
VITE_VIGNETTE_CLIENT_ID=vgc_...
